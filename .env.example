# Prompt Compiler Environment Configuration

# ----------------------------------------------------
# 1. Google Cloud Vertex AI (Gemini 3.5 Flash / 3.1 Flash)
# ----------------------------------------------------
GCP_PROJECT_ID=warm-skill-503300-b0
GCP_REGION=us-central1
GEMINI_API_KEY=your_gemini_or_vertex_api_key_here

# ----------------------------------------------------
# 2. Azure AI Foundry / Azure OpenAI (GPT-4.1 Mini)
# ----------------------------------------------------
AZURE_AI_ENDPOINT=https://mbusoharvey-8727-resource.services.ai.azure.com
AZURE_OPENAI_KEY=your_azure_foundry_api_key_here
AZURE_DEPLOYMENT_NAME=gpt-4.1-mini

# ----------------------------------------------------
# 3. Default Provider & Model Selection
# ----------------------------------------------------
# Options: local | vertex | azure | openai | anthropic
COMPILER_PROVIDER=azure
COMPILER_MODEL=gpt-4.1-mini
PORT=3000
